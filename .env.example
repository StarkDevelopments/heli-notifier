# Copy to .env and fill in. Never commit .env: it holds your position and
# your credentials, and the file is gitignored for exactly that reason.

# Watched position. Required - there is no default in the source, so a fresh
# clone cannot accidentally watch someone else's sky.
HELI_NOTIFIER_LAT=
HELI_NOTIFIER_LON=

# Pushover credentials. See https://pushover.net -> create an application for
# the token; the user key is on your dashboard.
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=

# Optional overrides, all commented out by default.
# HELI_NOTIFIER_RADIUS_NM=15
# HELI_NOTIFIER_ALERT_RADIUS_KM=10
# PUSHOVER_DEVICE=
# PUSHOVER_SOUND=siren
# PUSHOVER_TTL_HOURS=12
